{
  "evaluation_config": {
    "experiment_name": "align_pareto_m3_m4_pareto_controller",
    "seed": 42,
    "eval_set": {
      "version": "v1",
      "m1_processed_dir": "data/processed/m1",
      "source_splits": [
        "val",
        "test"
      ],
      "per_quadrant_per_split": 50,
      "max_prompt_chars": 2000,
      "exclude_has_context": true,
      "output_path": "data/eval/eval_prompts.csv"
    },
    "models": {
      "tokenizer_name": "Qwen/Qwen3-0.6B",
      "dtype": "float32",
      "unaligned": {
        "id": "sft-helpful-only",
        "base_model": "Qwen/Qwen3-0.6B-Base",
        "sft_adapter": "models/m2/sft_adapter",
        "generated_by": "group_a"
      },
      "aligned": {
        "id": "qwen3-instruct",
        "model_name": "Qwen/Qwen3-0.6B",
        "generated_by": "group_b"
      },
      "interpolated": {
        "id": "sft-to-instruct",
        "generated_by": "group_a"
      }
    },
    "sweep": {
      "lambdas": [
        0.0,
        0.25,
        0.5,
        0.75,
        1.0
      ],
      "num_samples_per_prompt": 5,
      "temperature": 0.8,
      "top_p": 0.95,
      "max_new_tokens": 256,
      "sample_seeds": [
        0,
        1,
        2,
        3,
        4
      ],
      "chat_template": "models.tokenizer_name",
      "system_prompt": null,
      "enable_thinking": false,
      "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
      "cluster_distance_threshold": 0.3,
      "batch_size": 32
    },
    "judge": {
      "model_name": "Qwen/Qwen3Guard-Gen-4B",
      "dtype": "float16",
      "batch_size": 16,
      "max_new_tokens": 32
    },
    "metrics": {
      "broken_repeat_share": 0.3
    },
    "quick_test": {
      "prompts_per_quadrant_per_split": 2,
      "num_samples": 2,
      "lambdas": [
        0.0,
        0.5,
        1.0
      ],
      "max_new_tokens": 48
    },
    "controller": {
      "safety_reference_lambda": 1.0,
      "classifier_tag": "m1",
      "bootstrap_samples": 1000
    },
    "null_space": {
      "enabled": true,
      "epsilon": 1e-08,
      "projection_layers": [
        "q_proj",
        "v_proj"
      ]
    }
  },
  "environment": {
    "python": "3.12.12",
    "platform": "Linux-7.1.5-arch1-1-x86_64-with-glibc2.44",
    "packages": {
      "numpy": "2.5.4",
      "pandas": "3.0.6",
      "scipy": "1.18.1",
      "scikit-learn": "1.9.1",
      "torch": "2.15.0+cpu",
      "transformers": "5.22.2",
      "sentence-transformers": "6.2.0",
      "datasketch": "2.0.0",
      "huggingface_hub": "2.4.0",
      "pyarrow": "26.0.0",
      "matplotlib": "3.11.2",
      "seaborn": "0.13.2",
      "peft": null,
      "trl": null,
      "bitsandbytes": null
    },
    "gpu": null
  }
}